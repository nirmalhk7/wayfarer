{
  "expo": {
    "name": "Wayfarer",
    "slug": "wayfarer",
    "scheme": "wayfarer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.nirmalhk7.wayfarer",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#050B0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "./plugins/withGradleTestCompatibility.cjs",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wayfarer uses your location on this device to open your Census subdivision’s market while the app is in use."
        }
      ]
    ],
    "platforms": [
      "android"
    ]
  }
}
